# ==============================================================================
# Healix Healthcare AI Backend - Environment Configuration
# ==============================================================================

# ==============================================================================
# OpenRouter LLM & Remote Embeddings Configuration (Required)
# ==============================================================================
# Get your single API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Remote Embedding Model (No local model inference, zero PyTorch/CUDA memory usage)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_BATCH_SIZE=32

# Primary text chat / RAG answering model (Free tier on OpenRouter)
OPENROUTER_CHAT_MODEL=inclusionai/ling-3.0-flash-fin:free

# Fallback text model (used automatically if primary hits 429/rate-limit or error)
OPENROUTER_CHAT_MODEL_FALLBACK=google/gemma-4-31b-it:free

# Vision model for clinical document & image analysis
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Voice model (reserved for future TTS integration)
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free

# ==============================================================================
# Verified Active Models (Tested & Operational)
# ==============================================================================
OPENROUTER_MODEL_LING_3_FLASH=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL_CORTEX=cohere/north-mini-code:free
OPENROUTER_MODEL_GEMMA_4_31B=google/gemma-4-31b-it:free
OPENROUTER_MODEL_NEMOTRON_3_SUPER=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_NEMOTRON_3_5_LIGHTNING=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_NEMOTRON_3_NANO_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MODEL_LIQUID_LFM=liquid/lfm-2.5-2.6b:free
OPENROUTER_MODEL_DOTS_3_NOTE=dots-studio/dots-3-note-preview:free

# Additional OpenRouter Models
NEX_N2_5_PRO_MODEL=nex-agi/nex-n2.5-pro:free
LING_3_0_FLASH_VL_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_MODEL_NEX_N2_5_PRO=nex-agi/nex-n2.5-pro:free
OPENROUTER_MODEL_LING_3_FLASH_VL=inclusionai/ling-3.0-flash-vl:free

# ==============================================================================
# Web Search Configuration (Optional)
# ==============================================================================
# Get your key at https://tavily.com (Leave blank to use DuckDuckGo fallback)
TAVILY_API_KEY=

# ==============================================================================
# CORS & Server Settings for Production (Render & Vercel)
# ==============================================================================
# Set FRONTEND_ORIGIN to your Vercel deployment URL (e.g. https://healix.vercel.app).
# You can provide multiple comma-separated URLs (e.g. https://healix.vercel.app,http://localhost:5173).
# Note: All *.vercel.app domains are also automatically allowed by CORS regex.
FRONTEND_ORIGIN=http://localhost:5173

# Host & Port:
# On Render, the PORT environment variable is automatically injected (default 10000).
# Leave HOST as 0.0.0.0 for containerized / cloud environments.
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# Vector Store & Storage Persistence
# ==============================================================================
# Local directory for ChromaDB and SQLite healix.db
# If using a persistent disk on Render (e.g. mounted at /var/data):
# CHROMA_PERSIST_DIR=/var/data/vectorstore
CHROMA_PERSIST_DIR=./data/vectorstore

# ==============================================================================
# Bhashini Voice I/O Configuration (TTS & STT)
# ==============================================================================
# If you have a Bhashini Inference API Key (Dhruva portal), paste it below.
# BHASHINI_USER_ID is completely OPTIONAL and can be left empty!
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_ASR_SERVICE_ID=bhashini/iitm/asr-dravidian--gpu--t4
BHASHINI_TTS_SERVICE_ID=Bhashini/IITM/TTS
BHASHINI_CONFIG_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
