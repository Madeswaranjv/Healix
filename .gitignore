# ==============================================================================
# Healix AI Healthcare Assistant — .gitignore
# ==============================================================================

# Environment Variables & Secrets (CRITICAL: Never commit API keys)
.env
.env.*
!.env.example
*.env

# Python Virtual Environments & Packages
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Local SQLite & Vector Databases
backend/data/
*.db
*.sqlite
*.sqlite3
data/vectorstore/
chroma/
vectorstore/

# Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local
.vite/
.output/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Temporary Logs & System Cache
*.log
logs/
scratch/
.system_generated/
