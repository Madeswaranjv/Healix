# ==============================================================================
# Healix Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# For local development (pointing to local FastAPI server):
VITE_API_BASE_URL=http://localhost:8000

# For Vercel Production Deployment:
# In your Vercel Project Dashboard -> Settings -> Environment Variables, add:
# Key:   VITE_API_BASE_URL
# Value: https://<your-backend-service-name>.onrender.com
# (Make sure not to include a trailing slash, or our client code will automatically strip it)
